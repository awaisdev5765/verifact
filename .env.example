# VeriFact environment template — copy to .env (never commit the real file)
# See github-app/SETUP.md

# GitHub (dogfood + PR comments)
GITHUB_TOKEN=

# GitHub App webhook
VERIFACT_WEBHOOK_SECRET=
VERIFACT_PORT=8080

# Target app under verification
VERIFACT_TARGET=.
VERIFACT_START_CMD=npm start

# LLM-assisted intent extraction (optional; deterministic parser always runs)
VERIFACT_LLM_PROVIDER=openai
VERIFACT_LLM_API_KEY=
VERIFACT_LLM_MODEL=gpt-4o-mini
VERIFACT_LLM_BASE_URL=
